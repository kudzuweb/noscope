{
  "name": "noscope",
  "version": "0.0.1",
  "description": "An agent runtime built on the Incident Command System as its primitive",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "noscope": "bin/noscope"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "unused": "knip --no-progress",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm unused && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/node": "^24.3.0",
    "knip": "^6.7.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  }
}
