#!/usr/bin/env node
// A stand-in for the claude binary: records its argument list and stdin to NOSCOPE_STUB_LOG,
// then prints the stream claude -p --output-format stream-json prints: an init line, one
// assistant and one user line per tool call in NOSCOPE_STUB_TOOLS (a JSON array of
// {tool, input, result, isError}), and the result envelope. NOSCOPE_STUB_EXIT makes it exit
// with that code before the envelope, as a killed or crashed session would. The structured output is
// NOSCOPE_STUB_OUTPUT, or the next entry of NOSCOPE_STUB_OUTPUTS (a JSON array walked in
// order with the counter file NOSCOPE_STUB_OUTPUT_COUNTER), or a canned answered result; a planner call, recognised by its
// system prompt, gets NOSCOPE_STUB_PLAN instead, or the next entry of NOSCOPE_STUB_PLANS
// (a JSON array walked in order, the position kept in the file NOSCOPE_STUB_COUNTER).
// A leader's turn, recognised by the LeaderTurn schema (a `kind` of report or continue),
// gets NOSCOPE_STUB_TURN, or the next entry of NOSCOPE_STUB_TURNS (walked with the counter
// file NOSCOPE_STUB_TURN_COUNTER), or by default `continue` while the prompt says tasks
// remain and a progress report once it says none do. The IC's command turn, recognised by
// the CommandTurn schema (a `periodObjectives` property), gets NOSCOPE_STUB_COMMAND, or the
// next entry of NOSCOPE_STUB_COMMANDS (counter file NOSCOPE_STUB_COMMAND_COUNTER), or by
// default one objective and `continue`. A command turn answers every report its briefing
// lists (R4-2; the change report heads each `  - <unit>, report <event id>: <outcome>`,
// and a unit that reported twice is answered on its last): a turn with no
// `reportVerdicts`, or an empty list (the typed test helpers' default), gets one per
// reporting unit, `accepted` for a `met` report and `revise` with stub instructions
// otherwise, and a turn whose verdicts omit `reportId` or leave it empty gets each filled
// with the id of the last report listed for that unit, since a test cannot know the
// store's UUID. A command turn with no `situation` (R4-5) gets a stub one, and a report
// turn with no `report.situation` (R5-2) gets a stub slice picture, so a scripted
// turn need not carry the picture. Its review,
// recognised by the ReviewTurn schema (a
// `verdict` property), gets NOSCOPE_STUB_REVIEW, or the next entry of NOSCOPE_STUB_REVIEWS
// (counter file NOSCOPE_STUB_REVIEW_COUNTER), or by default `approve`. A command turn whose
// schema requires `briefingEvaluation` (the IC's first turn after a transfer of command)
// gets one default verdict added when the answer carries none, and an empty
// `briefingQuestions` (R5-8) when it carries none; a test whose briefing proposes
// questions scripts the rulings. The initial IC's size-up,
// recognised by the IncidentBriefing schema (an `incomingCommander` property), gets
// NOSCOPE_STUB_BRIEFING, or by default an investigation briefing with one objective, one
// unit sketched, no questions and claude-opus-5 as the incoming commander. The IC's
// handoff, recognised by the HandoffDocument schema (a `nextMove` property), gets
// NOSCOPE_STUB_HANDOFF or by default a one-line document. Every call ends with one
// assistant line whose message usage is the context of the call's last message (which
// the provider records as contextTokens): input_tokens is NOSCOPE_STUB_IC_CONTEXT on the
// IC's calls (command, review, handoff), or the next entry of NOSCOPE_STUB_IC_CONTEXTS
// (counter file NOSCOPE_STUB_IC_CONTEXT_COUNTER, the last entry repeating), or 1000 like
// every call; the envelope's usage repeats the same figures. A fresh call's session id is stub-session, or
// stub-session-N when NOSCOPE_STUB_SESSION_COUNTER names a counter file, so a test can tell
// one fresh session from the next. NOSCOPE_STUB_CALLS,
// when set, gets one JSON line appended per call: its kind (planner, leader, command,
// review, size-up, handoff, task), the resumed id, args and prompt.
// NOSCOPE_STUB_FAIL and NOSCOPE_STUB_EXIT leave a leader's and the IC's turns alone, so a test
// of a failing task session still gets its leader's turn; NOSCOPE_STUB_LEADER_FAIL fails every
// turn instead.
// NOSCOPE_STUB_SLEEP_MS makes a task call sleep that long after its tool lines, before the
// envelope, so a bound can kill it or a run can be held in flight; NOSCOPE_STUB_SLEEP_IF
// narrows the sleep to task calls whose prompt contains that text (a task's objective, say),
// so one task of a pass is slow and the rest are not; NOSCOPE_STUB_TURN_SLEEP_MS does the
// same for a leader's turns alone, so endings can land while a turn is in progress. A --resume call answers with the id it was given as
// session_id, as the real binary does; NOSCOPE_STUB_RESUME_FAIL names a session id whose
// resume exits 1 before any output, as the binary does for a session it cannot find.
// NOSCOPE_STUB_REFUSE names call ordinals (1-based, comma-separated, counted in the file
// NOSCOPE_STUB_CALL_COUNTER) the API refuses: after the init line the stub prints the
// `model_refusal_no_fallback` system line with the stream's snake_case keys
// (`api_refusal_category`, NOSCOPE_STUB_REFUSE_CATEGORY, default reasoning_extraction; the
// transcript spells them apiRefusalCategory), a synthetic assistant line with stop_reason
// refusal and the stop_details the transcript records on it, and a result with stop_reason
// refusal and the call's usage, then exits 1, on the shape Claude Code 2.1.272 logged on
// 2026-09-15 (the system line's keys from the binary's serializer, not seen live). Each
// NOSCOPE_STUB_CALLS line also carries `concurrent`, how many other stub processes on the same
// log were still running when this one started.
import {
  appendFileSync,
  existsSync,
  readdirSync,
  readFileSync,
  rmSync,
  writeFileSync,
} from "node:fs";
import { basename, dirname, join } from "node:path";

const args = process.argv.slice(2);
const calls = process.env.NOSCOPE_STUB_CALLS;
const lock = calls ? join(dirname(calls), `${basename(calls)}.lock.${process.pid}`) : null;
let concurrent = 0;
if (calls && lock) {
  concurrent = readdirSync(dirname(calls)).filter((f) =>
    f.startsWith(`${basename(calls)}.lock.`),
  ).length;
  writeFileSync(lock, "");
  const unlock = () => {
    try {
      rmSync(lock);
    } catch {}
  };
  process.on("exit", unlock);
  process.on("SIGTERM", () => {
    unlock();
    process.exit(143);
  });
}
const prompt = readFileSync(0, "utf8");
if (process.env.NOSCOPE_STUB_LOG)
  writeFileSync(
    process.env.NOSCOPE_STUB_LOG,
    JSON.stringify({ args, prompt, disableCompact: process.env.DISABLE_COMPACT ?? null }),
  );

const systemPrompt = args[args.indexOf("--system-prompt") + 1] ?? "";
const resumed = args.indexOf("--resume");
function freshSessionId() {
  const counter = process.env.NOSCOPE_STUB_SESSION_COUNTER ?? "";
  if (!counter) return "stub-session";
  const i = existsSync(counter) ? Number(readFileSync(counter, "utf8")) : 0;
  writeFileSync(counter, String(i + 1));
  return `stub-session-${i + 1}`;
}
const sessionId = resumed === -1 ? freshSessionId() : args[resumed + 1];
const isPlanner = systemPrompt.startsWith("You are the Planning Section");
const schema = JSON.parse(args[args.indexOf("--json-schema") + 1] ?? "{}");
const isLeaderTurn = Array.isArray(schema.properties?.kind?.enum) && schema.properties.kind.enum.includes("report");
const isCommandTurn = schema.properties?.periodObjectives !== undefined;
const isReviewTurn = schema.properties?.verdict !== undefined;
const isSizeUp = schema.properties?.incomingCommander !== undefined;
const isHandoff = schema.properties?.nextMove !== undefined;
const isIcCall = isCommandTurn || isReviewTurn || isHandoff;
const isTurn = isLeaderTurn || isIcCall || isSizeUp;
if (calls)
  appendFileSync(
    calls,
    `${JSON.stringify({
      kind: isPlanner
        ? "planner"
        : isLeaderTurn
          ? "leader"
          : isCommandTurn
            ? "command"
            : isReviewTurn
              ? "review"
              : isSizeUp
                ? "size-up"
                : isHandoff
                  ? "handoff"
                : "task",
      resume: resumed === -1 ? null : args[resumed + 1],
      concurrent,
      args,
      prompt,
    })}\n`,
  );
if (resumed !== -1 && process.env.NOSCOPE_STUB_RESUME_FAIL === sessionId) {
  process.stderr.write(`No conversation found with session ID: ${sessionId}\n`);
  process.exit(1);
}
if (process.env.NOSCOPE_STUB_REFUSE) {
  const counter = process.env.NOSCOPE_STUB_CALL_COUNTER ?? "";
  const ordinal = (counter && existsSync(counter) ? Number(readFileSync(counter, "utf8")) : 0) + 1;
  if (counter) writeFileSync(counter, String(ordinal));
  if (process.env.NOSCOPE_STUB_REFUSE.split(",").map(Number).includes(ordinal)) {
    const category = process.env.NOSCOPE_STUB_REFUSE_CATEGORY ?? "reasoning_extraction";
    const explanation =
      "This request was blocked as it seems to violate Anthropic's Terms of Service restrictions on reverse engineering or duplicating model outputs.";
    const usage = {
      input_tokens: 2,
      cache_creation_input_tokens: 23065,
      cache_read_input_tokens: 0,
      output_tokens: 0,
    };
    const refusal = [
      { type: "system", subtype: "init", session_id: sessionId },
      {
        type: "system",
        subtype: "model_refusal_no_fallback",
        level: "warning",
        original_model: "claude-opus-5",
        request_id: "req_stub",
        api_refusal_category: category,
        api_refusal_explanation: explanation,
        content: "",
        session_id: sessionId,
      },
      {
        type: "assistant",
        session_id: sessionId,
        parent_tool_use_id: null,
        message: {
          model: "<synthetic>",
          role: "assistant",
          content: [{ type: "text", text: `API Error: Opus 5's safeguards flagged this message. ${explanation} Try rephrasing the request in a new session or change your model.` }],
          stop_reason: "refusal",
          stop_details: { type: "refusal", category, explanation },
          usage,
        },
      },
      { duration_api_ms: 965, stop_reason: "refusal", session_id: sessionId, total_cost_usd: 0.23066, usage },
    ];
    process.stdout.write(`${refusal.map((l) => JSON.stringify(l)).join("\n")}\n`);
    process.exit(1);
  }
}

function nextOf(one, many, counterName, fallback) {
  const entries = process.env[many] ? JSON.parse(process.env[many]) : [];
  if (entries.length > 0) {
    const counter = process.env[counterName] ?? "";
    const i = counter && existsSync(counter) ? Number(readFileSync(counter, "utf8")) : 0;
    if (counter) writeFileSync(counter, String(i + 1));
    return entries[Math.min(i, entries.length - 1)];
  }
  if (process.env[one]) return JSON.parse(process.env[one]);
  return fallback();
}

const listedReports = [...prompt.matchAll(/^  - (\S+), report (\S+): (met|not_met|progress)\b/gm)]
  .map((m) => ({ unitId: m[1], reportId: m[2], outcome: m[3] }))
  .filter((r, i, all) => all.findLastIndex((o) => o.unitId === r.unitId) === i);

const defaultVerdict = (r) =>
  r.outcome === "met"
    ? { reportId: r.reportId, unitId: r.unitId, verdict: "accepted", instructions: "", why: "stub: met on the work shown" }
    : { reportId: r.reportId, unitId: r.unitId, verdict: "revise", instructions: "stub: carry on", why: `stub: ${r.outcome}` };

const STUB_SITUATION = {
  picture: "stub picture",
  evidence: [],
  open: [],
  assessment: { kind: "on_track", why: "stub: nothing tested yet" },
  changed: "stub: nothing yet",
};

// A leader's report with no `situation` (R5-2) gets a stub slice picture, as a command
// turn gets a stub situation, so every scripted report keeps its meaning.
const STUB_UNIT_SITUATION = {
  picture: "stub slice picture",
  evidence: [],
  open: [],
  changed: "stub: nothing yet",
};

const withReportSituation = (turn) =>
  turn && turn.kind === "report" && turn.report && turn.report.situation === undefined
    ? { ...turn, report: { ...turn.report, situation: STUB_UNIT_SITUATION } }
    : turn;

const withVerdicts = (turn) => ({
  ...turn,
  situation: turn.situation ?? STUB_SITUATION,
  reportVerdicts:
    turn.reportVerdicts === undefined || turn.reportVerdicts.length === 0
      ? listedReports.map(defaultVerdict)
      : turn.reportVerdicts.map((v) =>
          v.reportId === undefined || v.reportId === ""
            ? { ...v, reportId: listedReports.filter((r) => r.unitId === v.unitId).at(-1)?.reportId ?? "(no report listed)" }
            : v,
        ),
});

const nextCommand = () => {
  const turn = withVerdicts(
    nextOf("NOSCOPE_STUB_COMMAND", "NOSCOPE_STUB_COMMANDS", "NOSCOPE_STUB_COMMAND_COUNTER", () => ({
      periodObjectives: ["pursue the incident objective"],
      priorities: [],
      closeUnits: [],
      answers: [],
      questionsForHuman: [],
      capabilityRequests: [],
      grantRequests: [],
      incidentStatus: "continue",
      rationale: "stub command turn",
    })),
  );
  const evaluates = Array.isArray(schema.required) && schema.required.includes("briefingEvaluation");
  if (!evaluates) return turn;
  return {
    ...turn,
    briefingEvaluation: turn.briefingEvaluation ?? [
      { item: "the briefing's first objective", verdict: "accepted", why: "stub evaluation" },
    ],
    briefingQuestions: turn.briefingQuestions ?? [],
  };
};

const nextBriefing = () =>
  process.env.NOSCOPE_STUB_BRIEFING
    ? JSON.parse(process.env.NOSCOPE_STUB_BRIEFING)
    : {
        kind: "investigation",
        dominantProblem: "stub size-up: where the objective points",
        obviouslyNeeded: [{ what: "the working directory", checked: true, finding: "Bash ls: present" }],
        initialObjectives: ["establish where the objective points"],
        initialOrganization: ["one unit to read the code, leader on claude-haiku-4-5"],
        questionsForHuman: [],
        hazards: [],
        incomingCommander: {
          provider: "claude-code",
          model: "claude-opus-5",
          why: "stub: the default commander",
        },
      };

const nextReview = () =>
  nextOf("NOSCOPE_STUB_REVIEW", "NOSCOPE_STUB_REVIEWS", "NOSCOPE_STUB_REVIEW_COUNTER", () => ({
    verdict: "approve",
    rationale: "stub review",
  }));

const nextHandoff = () =>
  nextOf("NOSCOPE_STUB_HANDOFF", "", "", () => ({
    period: { objectives: ["pursue the incident objective"], priorities: [], why: "stub handoff" },
    units: [],
    hypothesis: { statement: "stub hypothesis", claims: [] },
    setAside: [],
    nextMove: "continue",
  }));

const icContext = isIcCall
  ? nextOf("NOSCOPE_STUB_IC_CONTEXT", "NOSCOPE_STUB_IC_CONTEXTS", "NOSCOPE_STUB_IC_CONTEXT_COUNTER", () => 1000)
  : 1000;

function nextTurn() {
  return withReportSituation(scriptedTurn());
}

function scriptedTurn() {
  if (process.env.NOSCOPE_STUB_TURNS) {
    const turns = JSON.parse(process.env.NOSCOPE_STUB_TURNS);
    const counter = process.env.NOSCOPE_STUB_TURN_COUNTER ?? "";
    const i = counter && existsSync(counter) ? Number(readFileSync(counter, "utf8")) : 0;
    if (counter) writeFileSync(counter, String(i + 1));
    return turns[Math.min(i, turns.length - 1)];
  }
  if (process.env.NOSCOPE_STUB_TURN) return JSON.parse(process.env.NOSCOPE_STUB_TURN);
  return prompt.includes("No ready tasks remain")
    ? { kind: "report", report: { outcome: "progress", changed: [], pictureChanged: false } }
    : { kind: "continue", report: null };
}

function nextPlan() {
  if (process.env.NOSCOPE_STUB_PLANS) {
    const plans = JSON.parse(process.env.NOSCOPE_STUB_PLANS);
    const counter = process.env.NOSCOPE_STUB_COUNTER ?? "";
    const i = counter && existsSync(counter) ? Number(readFileSync(counter, "utf8")) : 0;
    if (counter) writeFileSync(counter, String(i + 1));
    return plans[Math.min(i, plans.length - 1)];
  }
  return JSON.parse(process.env.NOSCOPE_STUB_PLAN ?? "null");
}

function nextOutput() {
  if (process.env.NOSCOPE_STUB_OUTPUTS) {
    const outputs = JSON.parse(process.env.NOSCOPE_STUB_OUTPUTS);
    const counter = process.env.NOSCOPE_STUB_OUTPUT_COUNTER ?? "";
    const i = counter && existsSync(counter) ? Number(readFileSync(counter, "utf8")) : 0;
    if (counter) writeFileSync(counter, String(i + 1));
    return outputs[Math.min(i, outputs.length - 1)];
  }
  if (process.env.NOSCOPE_STUB_OUTPUT) return JSON.parse(process.env.NOSCOPE_STUB_OUTPUT);
  return { outcome: "answered", claims: [], findings: { note: "stub" }, needed: [] };
}

const planned = isPlanner
  ? nextPlan()
  : isLeaderTurn
    ? nextTurn()
    : isCommandTurn
      ? nextCommand()
      : isReviewTurn
        ? nextReview()
        : isSizeUp
          ? nextBriefing()
          : isHandoff
            ? nextHandoff()
            : null;
const output = planned ?? nextOutput();
const failing = isTurn
  ? Boolean(process.env.NOSCOPE_STUB_LEADER_FAIL)
  : Boolean(process.env.NOSCOPE_STUB_FAIL);
const envelope = failing
  ? {
      type: "result",
      subtype: "error_during_execution",
      is_error: true,
      result: "stub failure",
      session_id: sessionId,
    }
  : {
      type: "result",
      subtype: "success",
      is_error: false,
      result: JSON.stringify(output),
      structured_output: output,
      session_id: sessionId,
      duration_ms: 1500,
      total_cost_usd: 0.0123,
      usage: {
        input_tokens: icContext,
        cache_creation_input_tokens: 200,
        cache_read_input_tokens: 300,
        output_tokens: 42,
      },
    };
const lines = [{ type: "system", subtype: "init", session_id: sessionId }];
const tools = JSON.parse(process.env.NOSCOPE_STUB_TOOLS ?? "[]");
tools.forEach((call, i) => {
  const id = `toolu_stub_${i + 1}`;
  lines.push({
    type: "assistant",
    session_id: "stub-session",
    parent_tool_use_id: null,
    timestamp: new Date(1_757_900_000_000 + i * 2_000).toISOString(),
    message: {
      role: "assistant",
      content: [{ type: "tool_use", id, name: call.tool, input: call.input ?? {} }],
    },
  });
  lines.push({
    type: "user",
    session_id: "stub-session",
    parent_tool_use_id: null,
    timestamp: new Date(1_757_900_000_000 + i * 2_000 + 1_500).toISOString(),
    message: {
      role: "user",
      content: [
        {
          type: "tool_result",
          tool_use_id: id,
          content: call.result ?? "",
          is_error: call.isError === true,
        },
      ],
    },
  });
});
// NOSCOPE_STUB_EXIT: die with that code after the tool lines, never reaching the result.
if (process.env.NOSCOPE_STUB_EXIT && !isTurn) {
  process.stdout.write(`${lines.map((l) => JSON.stringify(l)).join("\n")}\n`);
  process.exit(Number(process.env.NOSCOPE_STUB_EXIT));
}
// The answering message: its usage is the context the provider records for the session.
lines.push({
  type: "assistant",
  session_id: sessionId,
  parent_tool_use_id: null,
  timestamp: new Date(1_757_900_000_000 + tools.length * 2_000).toISOString(),
  message: {
    role: "assistant",
    id: "msg_stub_answer",
    content: [{ type: "text", text: "answered" }],
    usage: {
      input_tokens: icContext,
      cache_creation_input_tokens: 200,
      cache_read_input_tokens: 300,
      output_tokens: 42,
    },
  },
});
const sleepIf = process.env.NOSCOPE_STUB_SLEEP_IF ?? "";
const sleepMs = isLeaderTurn
  ? Number(process.env.NOSCOPE_STUB_TURN_SLEEP_MS ?? 0)
  : isTurn || (sleepIf !== "" && !prompt.includes(sleepIf))
    ? 0
    : Number(process.env.NOSCOPE_STUB_SLEEP_MS ?? 0);
if (sleepMs > 0) {
  process.stdout.write(`${lines.map((l) => JSON.stringify(l)).join("\n")}\n`);
  setTimeout(() => {
    process.stdout.write(`${JSON.stringify(envelope)}\n`);
  }, sleepMs);
} else {
  lines.push(envelope);
  process.stdout.write(`${lines.map((l) => JSON.stringify(l)).join("\n")}\n`);
}
